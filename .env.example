# Copy to .env.local and fill in the values. Never commit real secrets.
# In production (Vercel), set these under Project → Settings → Environment Variables.

# --- Email (Resend) ---
# API key from resend.com. The sending domain (atodtech.com) must be verified there.
RESEND_API_KEY=

# Sender for portal emails (invites, password resets). Must be on the verified domain.
# A bare address is sent as "Atod Tech <address>".
DMS_EMAIL_FROM=noreply@atodtech.com

# --- Database (Neon Postgres) ---
# Pooled connection string (host contains "-pooler"), used by the app at runtime.
DATABASE_URL=
# Direct connection string (no "-pooler"), used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED=

# --- Auth (Better Auth) ---
# Random secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The app's public URL. Production: https://www.atodtech.com
BETTER_AUTH_URL=http://localhost:3000

# Email of the DMS owner. `npm run dms:create-owner` creates this account.
DMS_OWNER_EMAIL=

# Public base URL used in invite links. Production: https://www.atodtech.com
# Inlined at build time, so redeploy after changing it.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- File storage (DigitalOcean Spaces, S3-compatible) ---
# Access key pair from DigitalOcean → API → Spaces Keys.
SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=lon1
SPACES_ENDPOINT=https://lon1.digitaloceanspaces.com
SPACES_BUCKET=kiddiedu
SPACES_PREFIX=atod-dms/
